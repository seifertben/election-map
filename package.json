{
  "name": "election-map-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:geo": "node scripts/build-geo.mjs",
    "build:polls": "node scripts/build-polls.mjs",
    "build:gov-polls": "node scripts/build-gov-polls.mjs",
    "build:demographics": "node scripts/fetch-demographics.mjs",
    "fetch:polls": "node scripts/fetch-wiki-polls.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "polygon-clipping": "^0.15.7",
    "shpjs": "^6.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.6"
  }
}
